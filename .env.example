# Copy to .dev.vars for local `next dev` / `wrangler dev` (see
# https://opennext.js.org/cloudflare/howtos/env-vars). In production, set
# these as Worker secrets: `wrangler secret put BETTER_AUTH_SECRET`, etc.
# D1 (binding: DB), R2 (binding: FILES) are configured in wrangler.jsonc,
# not here — they're bindings, not env vars.

# better-auth (decisions.md D-007, D-016). Generate with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Base URL better-auth uses to build magic-link callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# Resend (spec.md §3 — templated emails, reminders, .ics invites). Optional
# in dev: without it, src/lib/email.ts falls back to a stub sender that
# logs instead of sending.
RESEND_API_KEY=
