# Copy to .dev.vars for local `next dev` / `wrangler dev` (see
# https://opennext.js.org/cloudflare/howtos/env-vars). In production, set
# these as Worker secrets: `wrangler secret put BETTER_AUTH_SECRET`, etc.
# D1 (binding: DB), R2 (binding: FILES) are configured in wrangler.jsonc,
# not here — they're bindings, not env vars.

# better-auth (decisions.md D-007, D-016). Generate with:
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Base URL better-auth uses to build magic-link callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# Origin used for portal/event links inside outgoing email. Falls back to
# BETTER_AUTH_URL when unset.
APP_URL=http://localhost:3000

# Who gets admin on a fresh instance (decisions.md D-043). A comma-separated
# list of email addresses, matched case-insensitively: each one is promoted to
# admin every time it signs in, so a self-hosted deployment has a way in
# without hand-editing the database. This is the only automatic route to
# admin — there is no "first account to sign in wins" fallback. Leave it empty
# and your first admin is promoted by hand with the `wrangler d1 execute`
# one-liner in docs/deploying.md §7. Either way, roles after that are managed
# from Team (/admin/<event>/team).
#   ADMIN_EMAILS=you@example.com,cofounder@example.com
ADMIN_EMAILS=

# SendGrid (spec.md §7 — templated emails, reminders, .ics invites; D-030).
# Optional in dev: without it, src/lib/email.ts falls back to the dev
# transport, which prints each message and writes it to .dev-emails/
# (gitignored) for inspection — including the generated .ics.
SENDGRID_API_KEY=

# From identity on outgoing email. The address is also used as the calendar
# invite's ORGANIZER (RSVP replies go there), so in production it must be a
# SendGrid-verified sender — SendGrid has no shared sandbox sender the way
# Resend did, so sends fail closed until one is verified:
# https://www.twilio.com/docs/sendgrid/ui/sending-email/sender-verification
# Defaults to "Greenroom <no-reply@greenroom.localhost>", which only works
# with the dev transport.
EMAIL_FROM_NAME=Greenroom
EMAIL_FROM_ADDRESS=no-reply@greenroom.localhost

# Airtable one-way sync (docs/airtable-sync.md, decisions.md D-036). The token
# is a personal access token with data.records:read + data.records:write +
# schema.bases:write + schema.bases:read on the base — record read access lets
# the complete cron projection reconcile deleted Greenroom rows (D-090), and
# schema.bases:read lets the sync
# list the base's existing tables/fields (GET /v0/meta/bases/{id}/tables)
# before deciding what to create, on every run. In production both values are
# Worker secrets
# (`wrangler secret put AIRTABLE_API_KEY` / `AIRTABLE_BASE_ID`). The base id
# looks like `appXXXXXXXXXXXXXX` (Airtable URL, first path segment). With
# either value missing the sync no-ops with a "skipped" log line instead of
# failing the cron.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
