{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenroom",
  // Custom entry that wraps the OpenNext-generated fetch handler with a
  // `scheduled` handler for cron-triggered reminders (see custom-worker.ts).
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Logs: without this, a stalled request leaves nothing behind to
  // read after the fact — `wrangler tail` only shows what is happening while
  // it is attached. Sample every request (rate 1) rather than a fraction: the
  // failures we are chasing are intermittent, and the traffic is low enough
  // that full sampling is affordable.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // State the per-invocation CPU ceiling rather than inheriting it: a request
  // that burns it is then terminated with a CPU-limit error that shows up in
  // the logs above, instead of one more ambiguous failure. 30 s is the
  // maximum, so this raises no request's budget — it only makes it legible.
  "limits": { "cpu_ms": 30000 },
  // Owner-chosen production domain (zone must live on this Cloudflare
  // account); wrangler provisions the DNS record and certificate on deploy.
  "routes": [
    {
      "pattern": "greenroom.usespaces.dev",
      "custom_domain": true
    }
  ],
  // We serve on the custom domain only (the workers.dev route stays off).
  "workers_dev": false,
  // Required to fit the free plan's 3 MiB gzipped Worker cap — the unminified
  // bundle is 3.38 MiB gzipped and gets rejected (see learnings.md).
  "minify": true,
  // esbuild's keepNames injects a __name() call at every function/class
  // definition to preserve runtime .name; that overhead alone pushed the
  // bundle past the 3 MiB cap (3101 KiB gzipped). Nothing here dispatches on
  // function .name, so trade it away for the headroom.
  "keep_names": false,
  // Primary datastore (decisions.md D-002), created in region WNAM (D-033).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenroom",
      "database_id": "29d796f1-c44d-490f-8152-5d125a48f088",
      "migrations_dir": "migrations"
    }
  ],
  // Headshots, slides, and supporting documents (spec.md §2, decisions.md
  // "File storage"). Also backs the R2 incremental cache (open-next.config.ts).
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "greenroom-files"
    },
    // OpenNext's R2 incremental cache reads this exact binding name; it
    // shares the files bucket, writing under its own key prefix.
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "greenroom-files"
    }
  ],
  // Shared authenticated external-surface throttle (D-081). Both REST and
  // MCP pass the stable credential id, never the raw secret, as the key.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // The Airtable sync (docs/airtable-sync.md, decisions.md D-036) reads
  // AIRTABLE_API_KEY and AIRTABLE_BASE_ID as Worker secrets
  // (`wrangler secret put <NAME>`) — nothing account-specific is committed.
  // Local dev reads both from .dev.vars (see .env.example). With either
  // missing the sync no-ops with a log line rather than failing the cron.
  // Deadline reminders for speakers with incomplete tasks (spec.md §3,
  // decisions.md D-013) and the Airtable sync above. Runs both jobs every 15
  // minutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
